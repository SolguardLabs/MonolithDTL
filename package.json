{
  "name": "monolithdtl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic multi-product settlement and capital-control engine for DTL operations.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/run-tests.mjs",
    "test:go": "go test ./... -count=1",
    "test:integration": "node scripts/run-tests.mjs",
    "format:check": "prettier --check .",
    "scan": "node scripts/scan-public-surface.mjs",
    "integrity": "node scripts/release-integrity.mjs",
    "ci": "node scripts/run-ci.mjs",
    "loc": "node scripts/check-loc.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
