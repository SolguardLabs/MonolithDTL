{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MonolithDTL: build",
      "type": "process",
      "command": "npm",
      "args": ["run", "build"],
      "group": "build",
      "problemMatcher": ["$go"]
    },
    {
      "label": "MonolithDTL: test",
      "type": "process",
      "command": "npm",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "MonolithDTL: CI local",
      "type": "process",
      "command": "npm",
      "args": ["run", "ci"],
      "group": "test",
      "problemMatcher": ["$go"]
    }
  ]
}
